<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minecraft Bot - Panel</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>
    
    <div class="container">
        <h1>🎮 Minecraft Bot Yönetimi</h1>
        
        <div class="status-card" id="status">
            <h3>Bot Durumu</h3>
            <div id="bot-status">Yükleniyor...</div>
        </div>
        
        <div class="chat-container">
            <div class="chat-messages" id="chat"></div>
            <div class="chat-input">
                <input type="text" id="message" placeholder="Mesaj yaz...">
                <button onclick="sendMessage()">Gönder</button>
            </div>
        </div>
    </div>
    
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/minecraft.js"></script>
</body>
</html>
